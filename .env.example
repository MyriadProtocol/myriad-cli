MYRIAD_API_BASE_URL=https://api-v2.myriadprotocol.com/

# Optional: enables higher rate limits and access to protected endpoints.
# MYRIAD_API_KEY=

# Optional advanced machine-level overrides can be defined in:
#   $XDG_CONFIG_HOME/myriad/config.json (if XDG_CONFIG_HOME is set), otherwise ~/.config/myriad/config.json
# CLI flags override env vars, and env vars override global config values.

# Optional signer override for a single environment/context.
# Recommended flow is to run: myriad wallet setup
# MYRIAD_PRIVATE_KEY=0x...

# The default allowance, both for trades and swaps, matches the amount of the transaction by default.
# To reduce the number of steps per trade, set the allowance to a higher limit. Use `UNLIMITED` to set unlimited allowance.
MYRIAD_ALLOWANCE=UNLIMITED


# Defaults to BNB Chain, can be customised to other chains.
MYRIAD_CHAIN_ID=56
MYRIAD_RPC_URL=https://bsc-dataseed.binance.org/
MYRIAD_PM_CONTRACT=0x39E66eE6b2ddaf4DEfDEd3038E0162180dbeF340
