{
  "name": "@myriadmarkets/cli",
  "version": "0.1.3",
  "description": "Myriad CLI - Let agents trade prediction markets on Myriad Markets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "myriad": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall-check.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs"
  },
  "files": [
    "dist/**",
    "scripts/postinstall-check.mjs",
    "skills/**",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "myriad",
    "prediction-markets",
    "cli",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
